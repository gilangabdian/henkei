{
  "name": "henkei",
  "version": "0.1.2",
  "description": "Animate text using morphing polygons",
  "type": "module",
  "repository": "https://github.com/gilangabdian/henkei",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:demo": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "flubber": "^0.4.2",
    "framer-motion": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "node-fetch": "^3.3.2",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "polygon-clipping": "^0.15.7",
    "polymorph-js": "^1.0.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/flubber": "^0.4.0",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/paper": "^0.12.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "framer-motion": "^13.0.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
